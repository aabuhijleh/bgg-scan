# BGG XML API bearer token (https://boardgamegeek.com/applications)
# Used to authenticate with BoardGameGeek's XML API v2
BGG_XML_API_BEARER_TOKEN=

# UPC Item DB API (https://www.upcitemdb.com/wp/docs/main/development/getting-started/)
# Leave empty to use trial tier (100 req/day, no auth required)
# Set to your API key for paid tier with higher rate limits
UPC_ITEM_DB_API_KEY=
